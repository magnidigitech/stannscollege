  "teachingLearning": {
    "teachingLearningPractices": {
      "title": "Teaching-Learning Practices",
      "summary": "Teaching is supported through classroom instruction, discussions, presentations, seminars, assignments, tutorials, and continuous academic guidance.",
      "highlights": [
        "Interactive lectures and structured classroom presentations",
        "Group discussions and collaborative peer learning circles",
        "Tutorial sessions for concept reinforcement and doubts clearance",
        "Continuous academic mentoring and periodic feedback"
      ]
    },
    "innovativeTeachingPractices": {
      "title": "Innovative Teaching Practices",
      "summary": "Faculty members adopt innovative and activity-based methods such as case studies, group activities, problem-solving exercises, demonstrations, and interactive learning.",
      "highlights": [
        "Case study analysis for critical thinking and problem resolution",
        "Hands-on demonstration models and simulated laboratory setups",
        "Mind-mapping, peer presentations, and interactive quizzes",
        "Flipped classroom model and project-based assignments"
      ]
    },
    "experientialParticipativeLearning": {
      "title": "Experiential & Participative Learning",
      "summary": "Students engage in projects, field visits, internships, practical activities, workshops, seminars, and group-based learning to connect classroom knowledge with real-world applications.",
      "highlights": [
        "Mandatory industrial internships and institutional on-the-job training",
        "Community Service Projects (CSP) addressing local societal needs",
        "Educational field trips and industrial plant visits",
        "Student-led seminars, symposiums, and exhibitions"
      ]
    },
    "ictEnabledTeaching": {
      "title": "ICT-Enabled Teaching",
      "summary": "Digital tools and ICT resources are integrated into teaching through presentations, digital learning resources, online platforms, multimedia content, and other technology-enabled learning practices.",
      "highlights": [
        "Smart interactive classrooms equipped with multimedia projectors",
        "Integrated Learning Management System (ILMS) for course materials",
        "Online repositories, NPTEL/SWAYAM e-learning integrations",
        "Virtual laboratories and computer-assisted simulations"
      ]
    },
    "studentCentricLearning": {
      "title": "Student-Centric Learning",
      "summary": "The College promotes active student participation, collaborative learning, mentoring, individual academic support, and opportunities for skill development, with emphasis on the diverse learning needs of students.",
      "highlights": [
        "Proactive identification of slow and advanced learners",
        "One-on-one mentor-mentee counseling system",
        "Customized learning pathways and remedial coaching sessions",
        "Encouragement of student self-directed initiatives and leadership"
      ]
    }
  },
